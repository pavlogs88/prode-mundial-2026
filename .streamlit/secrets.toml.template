# .streamlit/secrets.toml
# ⚠️ NO subas este archivo a GitHub. Agregalo a .gitignore

# Google OAuth (obtenelo en console.cloud.google.com)
GOOGLE_CLIENT_ID = "xxxxxxxxxxxx.apps.googleusercontent.com"
